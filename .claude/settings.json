{
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-commit-invariants.ts\"",
						"timeout": 120
					},
					{
						"type": "command",
						"command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-push-evals.ts\"",
						"timeout": 900
					}
				]
			}
		]
	},
	"claudeMdExcludes": [
		"**/cc-settings/AGENTS.md"
	]
}
