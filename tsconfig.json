{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "types": ["bun"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "exactOptionalPropertyTypes": false,

    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": false,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "noEmit": true
  },
  "include": ["src/**/*", "tests/**/*"],
  // compaction-trigger.test.ts imports the compaction-trigger plugin, which
  // types itself against the ambient 'claude-code' module (generated by
  // Claude Code's /plugin-types, ../plugins/compaction-trigger/types) — a
  // module this project's tsconfig has no business resolving. bun test
  // erases the type-only import and runs the test fine; its own type
  // correctness is checked by `bun run typecheck:plugins` instead. Excluding
  // just this one file (nothing else imports it) keeps it out of tsc's
  // import graph without touching the plugins/** tree, which sits outside
  // "include" already.
  "exclude": ["tests/compaction-trigger.test.ts"]
}
