{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "types": ["bun"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "exactOptionalPropertyTypes": false,

    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": false,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "noEmit": true
  },
  "include": ["src/**/*", "tests/**/*"],
  // The two plugin unit tests import hook modules that type themselves
  // against the ambient 'claude-code' module (generated by Claude Code's
  // /plugin-types into plugins/types) — a module this project's tsconfig has
  // no business resolving. bun test erases the type-only imports and runs
  // them fine; their type correctness is checked by `bun run
  // typecheck:plugins` instead. Excluding just these files keeps them out of
  // tsc's import graph without touching the plugins/** tree, which sits
  // outside "include" already.
  "exclude": ["tests/compaction-trigger.test.ts", "tests/context-report.test.ts"]
}
