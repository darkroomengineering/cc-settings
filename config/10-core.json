{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"env": {
		"CLAUDE_CODE_EFFORT_LEVEL": "medium",
		"CLAUDE_CODE_SUBPROCESS_ENV_SCRUB": "1",
		"CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
		"CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
		"CLAUDE_CODE_SCRIPT_CAPS": "500",
		"ENABLE_TOOL_SEARCH": "auto:10",
		"CC_CLAUDE_MD_MONITOR_ENABLED": "true",
		"CC_CLAUDE_MD_WARN_LINES": "400",
		"CC_CLAUDE_MD_CRITICAL_LINES": "600",
		"CC_MAX_UNREVIEWED": "5",
		"CC_MIN_REVIEW_SECONDS": "60",
		"MCP_NEEDS_AUTH_PRUNE_KEEP": "claude.ai Granola",
		"CLAUDE_CODE_ENABLE_FUNCTION_HOOKS": "1"
	},
	"sandbox": {
		"failIfUnavailable": false
	},
	"extraKnownMarketplaces": {
		"fast-jev-compaction": {
			"source": {
				"source": "github",
				"repo": "tamaratran/fast-jev-compaction",
				"sha": "e3f262a7f4d42bd8dd32ced30d26176f7cb545b0"
			}
		},
		"cc-settings": {
			"source": {
				"source": "github",
				"repo": "darkroomengineering/cc-settings"
			}
		}
	},
	"enabledPlugins": {
		"fast-jev-compaction@fast-jev-compaction": true,
		"compaction-trigger@cc-settings": true,
		"context-report@cc-settings": true
	},
	"pluginConfigs": {
		"fast-jev-compaction@fast-jev-compaction": {
			"options": {
				"compactAtPercent": 100,
				"preserveRecentMessages": 6
			}
		}
	},
	"model": "claude-fable-5-1",
	"tui": "default",
	"promptCacheTtl": "1h",
	"subagentPromptCacheTtl": "5m",
	"outputStyle": "Darkroom",
	"remoteControlAtStartup": true,
	"fastModePerSessionOptIn": true,
	"showThinkingSummaries": true,
	"teammateMode": "auto",
	"includeGitInstructions": false,
	"attribution": {
		"commit": "",
		"pr": "",
		"sessionUrl": false
	},
	"plansDirectory": "./plans",
	"spinnerVerbs": {
		"mode": "replace",
		"verbs": [
			"Analyzing",
			"Architecting",
			"Building",
			"Checking",
			"Composing",
			"Crafting",
			"Debugging",
			"Deploying",
			"Designing",
			"Evaluating",
			"Exploring",
			"Implementing",
			"Investigating",
			"Optimizing",
			"Orchestrating",
			"Refactoring",
			"Researching",
			"Reviewing",
			"Scaffolding",
			"Testing",
			"Tracing",
			"Validating",
			"Wiring"
		]
	},
	"statusLine": {
		"type": "command",
		"command": "bun \"$HOME/.claude/src/hooks/statusline.ts\"",
		"refreshInterval": 30
	}
}
