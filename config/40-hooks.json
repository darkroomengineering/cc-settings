{
	"hooks": {
		"UserPromptSubmit": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "bun --no-env-file --config=\"$HOME/.claude/src/bunfig.toml\" \"$HOME/.claude/src/hooks/dispatch.ts\" UserPromptSubmit",
						"timeout": 3
					}
				]
			}
		],
		"PreModelSwitch": [
			{
				"matcher": ".*fable.*|.*mythos.*",
				"hooks": [
					{
						"type": "command",
						"command": "bun --no-env-file --config=\"$HOME/.claude/src/bunfig.toml\" \"$HOME/.claude/src/hooks/model-switch-guard.ts\"",
						"timeout": 5
					}
				]
			}
		],
		"PreToolUse": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "bun --no-env-file --config=\"$HOME/.claude/src/bunfig.toml\" \"$HOME/.claude/src/hooks/dispatch.ts\" PreToolUse",
						"timeout": 5,
						"onFailure": "block"
					}
				]
			},
			{
				"matcher": "Edit|Write",
				"hooks": [
					{
						"type": "command",
						"command": "bun --no-env-file --config=\"$HOME/.claude/src/bunfig.toml\" \"$HOME/.claude/src/hooks/dispatch.ts\" PreToolUse",
						"timeout": 5
					}
				]
			},
			{
				"hooks": [
					{
						"type": "command",
						"if": "Bash(bun add*) Bash(bun install*) Bash(npm install*)",
						"command": "bun --no-env-file --config=\"$HOME/.claude/src/bunfig.toml\" \"$HOME/.claude/src/scripts/check-docs-before-install.ts\""
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "Write|Edit|Bash|Agent",
				"hooks": [
					{
						"type": "command",
						"command": "bun --no-env-file --config=\"$HOME/.claude/src/bunfig.toml\" \"$HOME/.claude/src/hooks/dispatch.ts\" PostToolUse"
					}
				]
			},
			{
				"matcher": "Write|Edit",
				"hooks": [
					{
						"type": "command",
						"command": "bun --no-env-file --config=\"$HOME/.claude/src/bunfig.toml\" \"$HOME/.claude/src/scripts/post-edit-tsc.ts\"",
						"async": true
					}
				]
			},
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "bun --no-env-file --config=\"$HOME/.claude/src/bunfig.toml\" \"$HOME/.claude/src/scripts/log-bash.ts\"",
						"async": true,
						"timeout": 10
					}
				]
			}
		],
		"PostCompact": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "bun --no-env-file --config=\"$HOME/.claude/src/bunfig.toml\" \"$HOME/.claude/src/scripts/post-compact.ts\""
					}
				]
			}
		],
		"PreCompact": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "bun --no-env-file --config=\"$HOME/.claude/src/bunfig.toml\" \"$HOME/.claude/src/scripts/handoff.ts\" create --from-hook"
					}
				]
			}
		],
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "bun --no-env-file --config=\"$HOME/.claude/src/bunfig.toml\" \"$HOME/.claude/src/hooks/verify-hooks.ts\"",
						"timeout": 3
					},
					{
						"type": "command",
						"command": "bun --no-env-file --config=\"$HOME/.claude/src/bunfig.toml\" \"$HOME/.claude/src/scripts/session-start.ts\""
					},
					{
						"type": "command",
						"command": "bun --no-env-file --config=\"$HOME/.claude/src/bunfig.toml\" \"$HOME/.claude/src/hooks/codex-verify.ts\"",
						"timeout": 3,
						"async": true
					}
				]
			}
		],
		"SessionEnd": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "bun --no-env-file --config=\"$HOME/.claude/src/bunfig.toml\" \"$HOME/.claude/src/scripts/handoff.ts\" create --from-hook",
						"async": true,
						"timeout": 30
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "bun --no-env-file --config=\"$HOME/.claude/src/bunfig.toml\" \"$HOME/.claude/src/hooks/ask-gate.ts\"",
						"timeout": 5
					}
				]
			}
		],
		"PostToolUseFailure": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "bun --no-env-file --config=\"$HOME/.claude/src/bunfig.toml\" \"$HOME/.claude/src/scripts/post-failure.ts\"",
						"async": false,
						"timeout": 10
					}
				]
			}
		],
		"PostToolBatch": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "bun --no-env-file --config=\"$HOME/.claude/src/bunfig.toml\" \"$HOME/.claude/src/scripts/ledger-record.ts\"",
						"async": true,
						"timeout": 5
					}
				]
			}
		],
		"SubagentStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "bun --no-env-file --config=\"$HOME/.claude/src/bunfig.toml\" \"$HOME/.claude/src/scripts/swarm-log.ts\" start",
						"async": true,
						"timeout": 5
					}
				]
			}
		],
		"SubagentStop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "bun --no-env-file --config=\"$HOME/.claude/src/bunfig.toml\" \"$HOME/.claude/src/scripts/swarm-log.ts\" stop",
						"async": true,
						"timeout": 5
					}
				]
			}
		],
		"Notification": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "bun --no-env-file --config=\"$HOME/.claude/src/bunfig.toml\" \"$HOME/.claude/src/scripts/notify.ts\"",
						"async": true,
						"timeout": 10
					}
				]
			}
		],
		"TaskCreated": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "bun --no-env-file --config=\"$HOME/.claude/src/bunfig.toml\" \"$HOME/.claude/src/scripts/swarm-log.ts\" task",
						"async": true,
						"timeout": 5
					}
				]
			}
		],
		"TaskCompleted": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "bun --no-env-file --config=\"$HOME/.claude/src/bunfig.toml\" \"$HOME/.claude/src/scripts/swarm-log.ts\" complete",
						"async": true,
						"timeout": 5
					}
				]
			}
		]
	}
}
